      "targets": [
        {
          "dataset": "meshtastic",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH NodeCheck AS (\r\n  SELECT COUNT(*) > 0 as is_gw FROM mesh_packet_metrics WHERE $__timeFilter(time) AND REPLACE(reporting_gateway::text, '!', '') = REPLACE('${node_id}', '!', '')\r\n)\r\nSELECT\r\n  CASE\r\n    WHEN (SELECT is_gw FROM NodeCheck) = false THEN NULL\r\n    WHEN COUNT(packet_id) = 0 THEN 0\r\n    ELSE ROUND((COUNT(CASE WHEN REPLACE(reporting_gateway::text, '!', '') != REPLACE('${node_id}', '!', '') THEN 1 END)::numeric / COUNT(packet_id)::numeric) * 100.0, 1)\r\n  END AS percent_heard\r\nFROM mesh_packet_metrics\r\nWHERE $__timeFilter(time) AND REPLACE(source_id::text, '!', '') = REPLACE('${node_id}', '!', '');",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "% of sent messages heard by other gateways",
