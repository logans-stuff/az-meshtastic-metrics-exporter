          "rawSql": "WITH NodeTopics AS (\r\n  -- Extract region and channel for every node\r\n  SELECT\r\n    REPLACE(node_id::text, '!', '') AS nid,\r\n    TRIM(REPLACE(substring(last_heard_topic from '^msh/(.*?)/2/[ce]/'), 'US/AZ/', '')) AS region,\r\n    substring(last_heard_topic from '/([^/]+)/![a-fA-F0-9]+$') AS channel\r\n  FROM node_details\r\n  WHERE last_heard_topic IS NOT NULL\r\n),\r\nRegionConsensus AS (\r\n  -- Rank the channels in each region by popularity\r\n  SELECT\r\n    region,\r\n    channel AS consensus_channel,\r\n    ROW_NUMBER() OVER(PARTITION BY region ORDER BY COUNT(*) DESC) as rn\r\n  FROM NodeTopics\r\n  WHERE region IS NOT NULL AND region != '' AND channel IS NOT NULL AND channel != ''\r\n  GROUP BY region, channel\r\n),\r\nDominantChannels AS (\r\n  -- Lock in the #1 most popular channel for each region\r\n  SELECT region, consensus_channel\r\n  FROM RegionConsensus\r\n  WHERE rn = 1\r\n),\r\nThisNode AS (\r\n  SELECT region, channel\r\n  FROM NodeTopics\r\n  WHERE nid = REPLACE('${node_id}', '!', '')\r\n)\r\n\r\nSELECT\r\n  CASE\r\n    WHEN t.region IS NULL THEN 'No Topic Data'\r\n    WHEN t.channel = d.consensus_channel THEN '\u2705 True (' || t.channel || ')'\r\n    ELSE '\u274c False (Is ' || COALESCE(t.channel, 'Unknown') || ', Region consensus is ' || COALESCE(d.consensus_channel, 'Unknown') || ')'\r\n  END AS status\r\nFROM ThisNode t\r\nLEFT JOIN DominantChannels d ON t.region = d.region;",
          "refId": "A",
          "sql": {
            "columns": [
              {
