      "targets": [
        {
          "dataset": "meshtastic",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH NodeCheck AS (\r\n  SELECT COUNT(*) > 0 as is_gw FROM mesh_packet_metrics WHERE $__timeFilter(time) AND REPLACE(reporting_gateway::text, '!', '') = REPLACE('${node_id}', '!', '')\r\n),\r\nTargetedAtNode AS (\r\n  -- Find all packets sent to this node\r\n  SELECT packet_id\r\n  FROM mesh_packet_metrics\r\n  WHERE $__timeFilter(time)\r\n    AND REPLACE(destination_id::text, '!', '') = REPLACE('${node_id}', '!', '')\r\n    AND LOWER(REPLACE(destination_id::text, '!', '')) NOT IN ('ffffffff', '^all', 'all')\r\n),\r\nArrivedAtNode AS (\r\n  -- Prove they arrived by checking if this node uploaded them\r\n  SELECT DISTINCT t.packet_id\r\n  FROM TargetedAtNode t\r\n  JOIN mesh_packet_metrics m ON t.packet_id = m.packet_id\r\n  WHERE REPLACE(m.reporting_gateway::text, '!', '') = REPLACE('${node_id}', '!', '')\r\n)\r\nSELECT\r\n  CASE\r\n    WHEN (SELECT is_gw FROM NodeCheck) = false THEN NULL\r\n    WHEN (SELECT COUNT(*) FROM TargetedAtNode) = 0 THEN 0\r\n    ELSE ROUND(((SELECT COUNT(*) FROM ArrivedAtNode)::numeric / (SELECT COUNT(*) FROM TargetedAtNode)::numeric) * 100.0, 1)\r\n  END AS inbound_success_rate;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "% of messages sent to this node that made it",
      "type": "stat"
